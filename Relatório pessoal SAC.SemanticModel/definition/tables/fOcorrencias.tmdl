table fOcorrencias
	lineageTag: 68fc15ec-8396-4670-988d-c29ac612a734

	measure 'Total Atendimentos' = COUNTROWS(fOcorrencias)
		formatString: 0
		lineageTag: e6b623a2-ead0-45e2-8b3f-0f24e82e5555

	measure 'Tempo Médio de Retorno (Dias)' = AVERAGE(fOcorrencias[Qtd Dias P/Resposta])
		lineageTag: eccd96ed-08bf-49c7-88c9-59218cd58bcf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tempo Médio Atendimento (Minutos)' = AVERAGE(fOcorrencias[Tempo Atendimento (Min)])
		lineageTag: 7a4d6403-6011-4b80-9a08-e5287ca4ea0e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Média Diária Chamados' = [Total Atendimentos]/DISTINCTCOUNT(fOcorrencias[Data Chamado])
		lineageTag: 4bf4b895-8de1-4cfc-a31c-04a876ebc8ed

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Chamados Cancelados' = CALCULATE([Total Atendimentos], fOcorrencias[Status] = "Cancelado")
		formatString: 0
		lineageTag: 13f1503e-8334-4a64-98cc-e7f0439b7cc5

	measure '% Cancelados' = [Chamados Cancelados]/[Total Atendimentos]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 79fc50c1-fd11-4907-a4a6-5c6e04d4a87f

